---
import '../../styles/global.css';
import { readCatalog, readManifest } from '../../lib/build-data';

const catalog = readCatalog();
export function getStaticPaths() {
  return readManifest().categories.map((category) => ({ params: { slug: category.id }, props: { category } }));
}
const { category } = Astro.props;
const items = catalog.filter((symbol) => symbol.categories.includes(category.id));
const siteTitle = `${category.names['zh-CN']} · Unicode 符号选择器`;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}og-image.png`, Astro.site).href;
const description = `浏览 ${category.names['zh-CN']} 分类中的 ${items.length} 个 Unicode 符号。`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Unicode 符号选择器" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body class="seo-page">
    <header class="seo-header">
      <a href={base} class="seo-brand"><span class="brand-mark" aria-hidden="true">✦</span>Unicode 符号选择器</a>
      <a href={base} class="seo-back">打开选择器 →</a>
    </header>
    <main class="seo-main">
      <p class="seo-kicker">Unicode 17.0 / Category</p>
      <h1>{category.names['zh-CN']}</h1>
      <p class="seo-lede">这里收录 {items.length} 个属于“{category.names['zh-CN']}”的核心 Unicode 符号。点击任意符号可返回选择器查看编码详情。</p>
      <div class="seo-symbol-list">
        {items.slice(0, 120).map((symbol) => (
          <a class="seo-symbol" href={`${base}symbol/${symbol.id}/`}>
            <span class="symbol-char" aria-hidden="true">{symbol.value}</span>
            <span>{symbol.nameZh || symbol.name}</span>
            <code>{symbol.codePoints[0]}</code>
          </a>
        ))}
      </div>
    </main>
  </body>
</html>
