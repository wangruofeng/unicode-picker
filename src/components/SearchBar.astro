<div class="search-toolbar">
  <label class="search-field">
    <span class="search-icon" aria-hidden="true">⌕</span>
    <input
      id="searchInput"
      type="search"
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"
      spellcheck="false"
      data-i18n-aria="searchLabel"
      aria-label="搜索符号"
      data-i18n-placeholder="searchPlaceholder"
      placeholder="搜索符号、中文名、英文名或码点…"
    />
    <kbd data-i18n="searchShortcut">/</kbd>
    <button id="clearSearch" class="clear-search" type="button" data-i18n-title="clearSearch" data-i18n-aria="clearSearch" aria-label="清空搜索" hidden></button>
  </label>
  <div id="statBar" class="result-stat" aria-live="polite"></div>
</div>
